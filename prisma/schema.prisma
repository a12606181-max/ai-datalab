generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TEACHER
}

enum ProgressType {
  LESSON
  LAB
  COURSE
}

enum SubmissionStatus {
  CHECKED
  PENDING
}

enum MentorRole {
  USER
  AI
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  passwordHash   String
  role           UserRole
  level          String          @default("Beginner")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  submissions    Submission[]
  progress       Progress[]
  skillProgress  SkillProgress[]
  mentorMessages MentorMessage[]
}

model Course {
  id            String     @id @default(cuid())
  title         String
  description   String
  difficulty    String
  lessonsCount  Int
  imageGradient String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lessons       Lesson[]
  progress      Progress[]
}

model Lesson {
  id               String     @id @default(cuid())
  courseId         String
  title            String
  content          String
  order            Int
  estimatedMinutes Int
  createdAt        DateTime   @default(now())
  course           Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quizzes          Quiz[]
  progress         Progress[]
}

model Quiz {
  id            String   @id @default(cuid())
  lessonId      String
  order         Int
  question      String
  options       String
  correctAnswer String
  explanation   String
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Lab {
  id              String        @id @default(cuid())
  title           String
  description     String
  goal            String
  difficulty      String
  deadline        DateTime
  datasetId       String?
  requiredFormat  String?
  minAnswerLength Int           @default(30)
  createdAt       DateTime      @default(now())
  dataset         Dataset?      @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  submissions     Submission[]
  progress        Progress[]
}

model Dataset {
  id          String   @id @default(cuid())
  title       String
  description String
  filename    String
  rowsCount   Int
  size        String
  tags        String
  createdAt   DateTime @default(now())
  labs        Lab[]
}

model Submission {
  id               String           @id @default(cuid())
  userId           String
  labId            String
  answerText       String
  uploadedFileName String?
  score            Int
  status           SubmissionStatus
  feedback         String
  createdAt        DateTime         @default(now())
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lab              Lab              @relation(fields: [labId], references: [id], onDelete: Cascade)
}

model Progress {
  id        String       @id @default(cuid())
  userId    String
  courseId  String?
  lessonId  String?
  labId     String?
  type      ProgressType
  value     Int
  completed Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson    Lesson?      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lab       Lab?         @relation(fields: [labId], references: [id], onDelete: Cascade)
}

model SkillProgress {
  id     String @id @default(cuid())
  userId String
  skill  String
  value  Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MentorMessage {
  id        String     @id @default(cuid())
  userId    String
  role      MentorRole
  content   String
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}
